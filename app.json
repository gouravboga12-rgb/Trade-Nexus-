{
  "expo": {
    "name": "Trade Nexus Trade Smart",
    "slug": "tradex-mobile",
    "owner": "tradenexustrade",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tradenexus.tradesmart"
    },
    "android": {
      "package": "com.tradenexus.tradesmart",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#07192C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "CALL_PHONE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Trade Nexus requires camera access for Biometric Face ID attendance punch-in."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Trade Nexus requires location access to verify office geofence attendance check-ins."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00C9A7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d852e74d-c724-4241-a1c5-03ee7c5df28c"
      }
    }
  }
}
